{
  "expo": {
    "name": "Uber for Cleaning",
    "slug": "uber-for-cleaning",
    "version": "1.1.0",
    "cli": {
      "appVersionSource": "remote"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uberforcleaning",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.uberforcleaning.app"
    },
    "android": {
      "package": "com.uberforcleaning.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00C896"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Uber for Cleaning needs access to your photos for booking verification.",
          "cameraPermission": "Uber for Cleaning needs access to your camera for before/after photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Uber for Cleaning needs your location to find nearby cleaners."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8a0b997-82ac-47cc-b652-a3d3540a4d61"
      }
    },
    "owner": "kingdomjoe"
  }
}
